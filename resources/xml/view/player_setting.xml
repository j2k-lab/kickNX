<brls:Box
    width="auto"
    height="auto"
    justifyContent="flexEnd"
    backgroundColor="@theme/brls/backdrop">

    <brls:Box
        id="player/cancel"
        height="100%"
        hideClickAnimation="true"
        grow="1" />

    <brls:Box
        width="460"
        height="100%"
        axis="column"
        backgroundColor="@theme/brls/background">

        <brls:ScrollingFrame
            id="player/settings"
            width="100%"
            grow="1"
            scrollingBehavior="centered">

            <brls:Box
                width="auto"
                height="auto"
                axis="column"
                paddingTop="@style/main/content_padding_top_bottom"
                paddingLeft="@style/main/content_padding_sides"
                paddingRight="@style/main/content_padding_sides"
                paddingBottom="@style/main/content_padding_top_bottom"
                alignItems="stretch">

                <brls:Header
                    width="auto"
                    height="auto"
                    title="@i18n/main/setting/playback/header" />
                <brls:Box
                    width="100%"
                    height="auto"
                    axis="column"
                    marginBottom="30px">
                    <brls:SelectorCell
                        id="setting/kick/quality" />
                    <brls:SelectorCell
                        id="setting/kick/decoder" />
                    <brls:SelectorCell
                        id="setting/portrait/orientation" />
                    <brls:SelectorCell
                        id="setting/portrait/keyboard_haptic" />
                    <brls:SelectorCell
                        id="setting/kick/chat_mode" />
                    <brls:SelectorCell
                        id="setting/kick/chat_participation" />
                    <brls:SelectorCell
                        id="setting/kick/chat_composer" />
                    <brls:SelectorCell
                        id="setting/kick/chat_emotes" />
                    <brls:SelectorCell
                        id="setting/kick/chat_overlay_size" />
                    <brls:SelectorCell
                        id="setting/kick/chat_overlay_position" />
                    <brls:SelectorCell
                        id="setting/kick/chat_docked_width" />
                    <brls:SelectorCell
                        id="setting/kick/chat_overlay_width" />
                    <brls:SelectorCell
                        id="setting/kick/chat_font" />
                    <brls:SelectorCell
                        id="setting/kick/chat_opacity" />
                    <brls:BooleanCell
                        id="setting/kick/chat_timestamps" />
                    <brls:SelectorCell
                        id="setting/track/audio" />
                    <brls:SelectorCell
                        id="setting/track/subtitle" />
                    <brls:SliderCell
                        id="setting/video/subsync" />
                </brls:Box>

                <brls:Header
                    width="auto"
                    height="auto"
                    title="@i18n/main/setting/equalizer/header"
                    marginBottom="0px" />
                <brls:Box
                    width="100%"
                    height="auto"
                    axis="column"
                    marginBottom="30px">
                    <brls:SliderCell
                        id="setting/equalizer/brightness" />
                    <brls:SliderCell
                        id="setting/equalizer/contrast" />
                    <brls:SliderCell
                        id="setting/equalizer/saturation" />
                    <brls:SliderCell
                        id="setting/equalizer/gamma" />
                    <brls:SliderCell
                        id="setting/equalizer/hue" />
                    <brls:RadioCell
                        id="setting/equalizer/reset"
                        title="@i18n/main/setting/equalizer/reset" />
                </brls:Box>

            </brls:Box>

        </brls:ScrollingFrame>
    </brls:Box>
</brls:Box>
